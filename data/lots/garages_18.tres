tale_ru = "Почти квартира. Диван, шкаф Нарния, персидский ковёр. На фото — Мин и Борис. Борис в другом районе. Мин тоже. Метлу просят, потому что «почти дом»."
tale_en = "Almost an apartment. Sofa, Narnia wardrobe, Persian rug. The photos show a Ming and Boris. Boris is in another district. So is the Ming. They want a broom because it is «almost a home»."
docs_ru = "ГАРАЖ 18 — КВАРТИРА:\nДиван кожа — 1\nШкаф Нарния — 1\nКовёр персидский — 1\nВиски односолодовый в ящике\nМин и хомяк — на фото, не здесь"
docs_en = "GARAGE 18 — APARTMENT:\nLeather sofa — 1\nNarnia wardrobe — 1\nPersian rug — 1\nSingle malt in a crate\nMing and hamster — in the photos, not here"
photo_item_ids = Array[String](["sofa_leather", "vase_ming", "hamster_boris", "plasma_55"])
cell_size = Vector3(5.0, 3.0, 6.0)
dark = false
