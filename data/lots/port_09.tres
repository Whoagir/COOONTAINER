tale_ru = "Коносамент обещает вертолёт. Вертолёта нет. Есть кирпичи, мышь и левый кроссовок. Таможня поставила печать «стройматериалы» дважды — на всякий случай. Метлу просят, мышь не мести."
tale_en = "The manifest promises a helicopter. No helicopter. There are bricks, a mouse, and a left sneaker. Customs stamped «building materials» twice — just in case. They want a broom. Do not sweep the mouse."
docs_ru = "КОНОСАМЕНТ 9909-П\n1× Вертолёт — НЕТ\n1× Автомобиль — НЕТ\n1× Кроссовок левый — да\nКирпичи — да\nМышь — не в описи, в контейнере"
docs_en = "BILL OF LADING 9909-P\n1× Helicopter — NO\n1× Automobile — NO\n1× Left sneaker — yes\nBricks — yes\nMouse — not on the sheet, in the box"
photo_item_ids = Array[String]([])
cell_size = Vector3(2.3, 2.4, 6.0)
dark = false
