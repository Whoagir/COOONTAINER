tale_ru = "Последний контейнер волны. Дед держал тут коллекцию… всего. Ваза Мин, слиток, Ролексы, Борис. Коносамент пишет «стулья». Стульев нет. Не зевайте."
tale_en = "Last container of the wave. Grandpa kept a collection of… everything. Ming vase, gold bar, Rolecks, Boris. The bill of lading says «chairs». No chairs. Do not yawn."
docs_ru = "КОНОСАМЕНТ 1414-ФИНАЛ\nСтулья — НЕТ\nВаза Мин — 1\nСлиток — 1\nРолекс настоящий — 1\nХомяк Борис — 1\nСейф + две пятисотки\nПечать: «не трясти». Трясли."
docs_en = "BILL OF LADING 1414-FINALE\nChairs — NO\nMing vase — 1\nGold bar — 1\nGenuine Rolecks — 1\nBoris the hamster — 1\nSafe + two five-hundreds\nStamp: «do not shake». They shook it."
photo_item_ids = Array[String]([])
cell_size = Vector3(2.3, 2.4, 6.0)
dark = false
