docs_en = "INVENTORY #11 (the «high value» stamp is crooked):\n1× Gold bar (gold paint)\n1× Sock (pair not found)\n1× Mouse (was living, still is)\n1× Lottery ticket (unscratched)\nSigned: «a classic»."
