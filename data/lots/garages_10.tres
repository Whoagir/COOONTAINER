tale_ru = "Хозяин сказал: «тут дворец». Дворца нет. Есть люстра дворцовая, виски старше вашего отца и сейф, который не любит гостей. Кирпичи у ворот — антураж."
tale_en = "Owner said: «there's a palace in there». No palace. There is a palace chandelier, whiskey older than your dad, and a safe that hates guests. Bricks at the door — set dressing."
docs_ru = "ГАРАЖ 10 — «ДВОРЕЦ»:\nЛюстра дворцовая — 1\nВиски 50 лет — 1\nСейф старый — 1 (заперт)\nРояля нет, есть пианино «Красный Октябрь»"
docs_en = "GARAGE 10 — «PALACE»:\nPalace chandelier — 1\n50-year whiskey — 1\nOld safe — 1 (locked)\nNo grand piano, there is a Red October upright"
photo_item_ids = Array[String]([])
cell_size = Vector3(5.0, 3.0, 6.0)
dark = false
