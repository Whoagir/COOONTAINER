[internationalization]

locale/translations=PackedStringArray("res://data/strings/strings.ru.translation", "res://data/strings/strings.en.translation")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="item"
3d_physics/layer_4="shard"
3d_physics/layer_5="vehicle"
3d_physics/layer_6="npc"
3d_physics/layer_7="liquid"
3d_physics/layer_8="trigger"
3d_physics/layer_9="ragdoll"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"
3d/sleep_threshold_linear=0.15
3d/sleep_threshold_angular=0.2
3d/time_before_sleep=0.6
common/physics_interpolation=true
jolt_physics_3d/simulation/allow_sleeping=true

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
scaling_3d/scale=0.85
environment/defaults/default_clear_color=Color(0.35, 0.42, 0.55, 1)
